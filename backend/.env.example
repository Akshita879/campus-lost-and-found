# Project Configuration
PROJECT_NAME="Campus Lost and Found Portal"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Database Configuration (MySQL 8)
DATABASE_URL="mysql+pymysql://root:your_mysql_password@127.0.0.1:3306/campus_lost_and_found"

# Security & JWT
JWT_SECRET_KEY="replace_this_with_a_secure_random_secret_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration (comma-separated origins or *)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500,*"

# File Uploads
UPLOAD_DIR="uploads"
MAX_IMAGE_SIZE_BYTES=5242880

# Matching Engine Configuration
MATCH_MIN_SCORE_THRESHOLD=25.0
MATCH_MAX_RESULTS=10
